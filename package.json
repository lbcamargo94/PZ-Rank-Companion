{
  "name": "pz-rank-companion",
  "version": "2.0.0",
  "description": "PZ Community Rank - Auto-sync companion",
  "author": {
    "name": "lbcamargo94",
    "email": "lb.camargo94@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "release": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always",
    "release:linux": "electron-builder --linux --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pzrank.companion",
    "productName": "PZ Rank Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "achievements-local.js",
      "renderer/**",
      "assets/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "lbcamargo94",
      "repo": "PZ-Rank-Companion",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "PZ.Rank.Companion.${version}.${ext}",
      "sign": null,
      "signingHashAlgorithms": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "PZ.Rank.Companion.${version}.Mac.${arch}.${ext}",
      "category": "public.app-category.utilities",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "PZ.Rank.Companion.${version}.${ext}",
      "category": "Utility"
    },
    "dmg": {
      "artifactName": "PZ.Rank.Companion.${version}.Mac.${arch}.dmg"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "PZ.Rank.Companion.Setup.${version}.exe"
    },
    "portable": {
      "artifactName": "PZ.Rank.Companion.${version}.exe"
    }
  }
}
